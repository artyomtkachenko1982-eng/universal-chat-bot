# ============================================
# Universal Chat Bot — переменные окружения
# Скопируй этот файл в .env и заполни своими данными
# ============================================

# --- DLE API (PHP-мостик на turbinist.ru) ---
DLE_API_URL=https://www.turbinist.ru/api-bot-bridge.php
DLE_API_TOKEN=tPWA_x7Kq9mN2wL5rT8vB3

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=universal_chat
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=change_me_please

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
